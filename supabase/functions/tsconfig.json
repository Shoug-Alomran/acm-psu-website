{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "deno.window"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["deno.ns", "deno.unstable"],
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"]
}
